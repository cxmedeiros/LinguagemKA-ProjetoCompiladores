fun t(n) { print n; return n; }
print t(1) + t(2) * t(3);
print t(1) - t(2) - t(3);
fun g3(a, b, c) { return a * 100 + b * 10 + c; }
print g3(t(1), t(2), t(3));
var x = 1;
print x + (x = 5);
print (x = 7) + x;
x = 1; print x + (x = 2) + x;
fun mut() { x = x + 10; return 1; }
x = 1; print x + mut(); x = 1; print mut() + x;
x = 5; x = x + mut(); print x;
fun loc() { var y = 1; fun m() { y = y + 10; return 1; } return y + m() + y; }
print loc();
fun loc2() { var y = 1; fun m() { y = y + 10; return 1; } var z = y + m(); return z + y; }
print loc2();
var a = 1; var b = 2; var c = 3;
a = b = c = 9; print a + b + c;
x = 1;
fun ga(p, q, r) { return p + q * 10 + r * 100; }
print ga(x, x = 2, x);
var o = {};
fun obj() { print "obj"; return o; }
fun val() { print "val"; return 5; }
obj().f = val(); print o.f;
print { a: t(1), b: t(2), c: t(3) }.c;
print nil or t(1); print 0 and t(2); print false or false; print 1 and 2; print nil and t(9);
print "a" or t(5); print nil or nil or "z"; print true and false or true;
print !nil; print !!1; print !0;
var cnt = 0;
fun inc() { cnt = cnt + 1; return cnt; }
print inc() + inc() * inc();
print inc() > 3 and inc() > 100 or inc();
print cnt;
var arr = { v: 1 };
arr.v = arr.v + (arr.v = 10);
print arr.v;
x = 3; x = x + x * (x = 4); print x;
fun pp(a) { a = a + 1; return a; }
x = 1; print pp(x) + x;
