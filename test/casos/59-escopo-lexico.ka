fun outer() {
  var v = "outer";
  fun inner() { return v; }
  var r1 = inner();
  v = "mudou";
  return r1 + "," + inner();
}
print outer();
{
  fun fatorial(n) { if (n <= 1) return 1; return n * fatorial(n - 1); }
  print fatorial(10);
}
